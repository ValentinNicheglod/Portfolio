---
import { Image } from "astro:assets";
import logo from "../../icons/logo.svg";
import "../../styles/global.scss";

const siteUrl = Astro.site ?? new URL("https://valentin-nicheglod.is-a.dev");
const homeUrl = new URL("/", siteUrl);
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting | Valentín Nicheglod</title>
    <meta
      name="description"
      content="Redirecting to the English version of Valentín Nicheglod's portfolio."
    />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0;url=${homeUrl.pathname}`} />
    <link rel="canonical" href={homeUrl} />
    <script is:inline>
      const target = new URL("/", window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;
      window.location.replace(target.toString());
    </script>
  </head>
  <body>
    <main
      class="relative flex min-h-screen min-h-[100dvh] items-center justify-center overflow-hidden px-6 py-12"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div
          class="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-primary/20 blur-3xl"
        ></div>
        <div
          class="absolute -bottom-48 -right-32 h-[32rem] w-[32rem] rounded-full bg-secondary/20 blur-3xl"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/5"></div>
      </div>

      <section
        class="inner-container relative w-full max-w-xl rounded-3xl px-6 py-10 text-center sm:px-12 sm:py-14"
        aria-labelledby="redirect-title"
      >
        <div class="mx-auto mb-8 flex w-fit rounded-full bg-white p-3 shadow-md">
          <Image src={logo} alt="" class="h-16 w-16" loading="eager" />
        </div>

        <p class="mb-3 text-7xl font-bold leading-none text-primary sm:text-8xl">/en</p>
        <h1 id="redirect-title" class="mb-4 text-3xl font-semibold sm:text-4xl">
          Redirecting to the English version
        </h1>
        <p class="mx-auto max-w-lg text-lg text-slate-600 dark:text-slate-300">
          You are being taken to the portfolio homepage.
        </p>

        <a
          href="/"
          class="mt-8 inline-flex rounded-full bg-primary px-6 py-3 font-medium text-white shadow-md transition-colors hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        >
          Continue to homepage
        </a>
      </section>
    </main>
  </body>
</html>
