---
import { Image } from "astro:assets";
import logo from "../icons/logo.svg";
import notFoundTranslations from "../locales/not-found.locales.json";
import "../styles/global.scss";

const siteUrl = Astro.site ?? new URL("https://valentin-nicheglod.is-a.dev");
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <title>404 | Valentín Nicheglod</title>
    <meta
      name="description"
      content={notFoundTranslations.en.description}
    />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={new URL("/404", siteUrl)} />
    <script is:inline>
      const pathLanguage = window.location.pathname
        .split("/")[1]
        ?.toLowerCase();
      const browserLanguage = navigator.language.toLowerCase();
      const language =
        pathLanguage === "es" ||
        (!pathLanguage && browserLanguage.startsWith("es"))
          ? "es"
          : "en";

      document.documentElement.lang = language;
      document.documentElement.dataset.language = language;

      try {
        const savedTheme = localStorage.getItem("theme-preference");
        const preferredTheme =
          savedTheme ??
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.dataset.theme = preferredTheme;
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body>
    <main
      class="relative flex min-h-screen min-h-[100dvh] items-center justify-center overflow-hidden px-6 py-12"
    >
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div
          class="absolute -left-40 -top-40 h-96 w-96 rounded-full bg-primary/20 blur-3xl"
        ></div>
        <div
          class="absolute -bottom-48 -right-32 h-[32rem] w-[32rem] rounded-full bg-secondary/20 blur-3xl"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-br from-transparent via-transparent to-primary/5"></div>
      </div>

      <section
        class="inner-container relative w-full max-w-2xl rounded-3xl px-6 py-10 text-center sm:px-12 sm:py-14"
        aria-labelledby="not-found-title"
      >
        <a
          href="/"
          class="mx-auto mb-8 flex w-fit rounded-full bg-white p-3 shadow-md outline-offset-4 transition-transform hover:scale-105 focus-visible:scale-105"
          aria-label={notFoundTranslations.en.logoAlt}
        >
          <Image src={logo} alt="" class="h-16 w-16" loading="eager" />
        </a>

        <p class="mb-3 text-8xl font-bold leading-none text-primary sm:text-9xl">404</p>

        <div data-language-copy="en">
          <h1 id="not-found-title" class="mb-4 text-3xl font-semibold sm:text-4xl">
            {notFoundTranslations.en.title}
          </h1>
          <p class="mx-auto max-w-lg text-lg text-slate-600 dark:text-slate-300">
            {notFoundTranslations.en.description}
          </p>
        </div>

        <div data-language-copy="es">
          <h1 class="mb-4 text-3xl font-semibold sm:text-4xl">
            {notFoundTranslations.es.title}
          </h1>
          <p class="mx-auto max-w-lg text-lg text-slate-600 dark:text-slate-300">
            {notFoundTranslations.es.description}
          </p>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            data-language-link="en"
            href="/"
            class="rounded-full bg-primary px-6 py-3 font-medium text-white shadow-md transition-colors hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            {notFoundTranslations.en.home}
          </a>
          <a
            data-language-link="es"
            href="/es"
            class="rounded-full bg-primary px-6 py-3 font-medium text-white shadow-md transition-colors hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            {notFoundTranslations.es.home}
          </a>
        </div>

        <nav class="mt-6 flex justify-center gap-3 text-sm" aria-label="Language selection">
          <a class="text-primary underline-offset-4 hover:underline" href="/">English</a>
          <span aria-hidden="true">·</span>
          <a class="text-primary underline-offset-4 hover:underline" href="/es">Español</a>
        </nav>
      </section>
    </main>
  </body>
</html>

<style>
  [data-language="es"] [data-language-copy="en"],
  [data-language="en"] [data-language-copy="es"],
  [data-language="es"] [data-language-link="en"],
  [data-language="en"] [data-language-link="es"] {
    display: none;
  }
</style>
